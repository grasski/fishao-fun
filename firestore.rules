rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks whether the requesting user is an administrator
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Market prices: public read, update allowed for authenticated users (cannot delete, strictly prices_history only)
    // NOTE: If you want ONLY admins to edit prices, change 'create, update' condition to: if isAdmin();
    match /fishao_market/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && docId == 'prices_history'
        && request.resource.data.keys().hasOnly(['prices', 'lastUpdated'])
        && request.resource.data.prices is map;
      allow delete: if isAdmin();
    }

    // User profiles: strictly isolated per user, protected from arbitrary field injection
    match /users/{userId} {
      // Users can only read their own profile (protects email & privacy); admins can read all
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Admin has full write access (management, role assignment, data cleanup)
      allow write: if isAdmin();

      // Profile creation on first Google Sign-In
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'displayName', 'email', 'photoURL', 'role', 
             'clubName', 'clubPoints', 'caughtFishIds', 
             'createdAt', 'lastLogin'
           ])
        && request.resource.data.role == 'member'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.clubPoints is number
        && request.resource.data.clubPoints >= 0
        && request.resource.data.caughtFishIds is list
        && request.resource.data.caughtFishIds.size() <= 1000;

      // Profile update by owner: forbidden from modifying 'role', 'email' or 'createdAt'
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'displayName', 'photoURL', 'clubName', 'clubPoints', 
             'caughtFishIds', 'lastLogin'
           ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.clubPoints is number
        && request.resource.data.clubPoints >= 0
        && request.resource.data.caughtFishIds is list
        && request.resource.data.caughtFishIds.size() <= 1000;

      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }
  }
}
