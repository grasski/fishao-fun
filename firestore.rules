rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks whether the requesting user is an administrator
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Market prices: public read, update allowed for authenticated users (cannot delete, strictly prices_history only)
    match /fishao_market/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && docId == 'prices_history'
        && request.resource.data.keys().hasOnly(['prices', 'lastUpdated'])
        && request.resource.data.prices is map;
      allow delete: if isAdmin();
    }

    // Shared Clubs collection: public read, authenticated write/update
    match /clubs/{clubId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'name', 'name_lower', 'points', 'unlockedFcFishIds', 
             'unlockedMonsterIds', 'memberCount', 'createdBy', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.unlockedFcFishIds is list
        && request.resource.data.unlockedMonsterIds is list
        && request.resource.data.memberCount is number
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'name_lower', 'points', 'unlockedFcFishIds', 
             'unlockedMonsterIds', 'memberCount', 'updatedAt', 'lastUpdatedBy'
           ])
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.unlockedFcFishIds is list
        && request.resource.data.unlockedMonsterIds is list
        && request.resource.data.memberCount is number;

      allow delete: if isAdmin();
    }

    // User profiles: GDPR-free (NO email, NO avatar photo stored in DB)
    match /users/{userId} {
      // Users can only read their own profile; admins can read all
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Admin has full write access
      allow write: if isAdmin();

      // Profile creation on first sign-in
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'displayName', 'role', 'clubId', 'clubName', 
             'caughtFishIds', 'createdAt', 'lastLogin', 'avatarUrl'
           ])
        && request.resource.data.role == 'member'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && (!('avatarUrl' in request.resource.data) || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 500))
        && request.resource.data.caughtFishIds is list
        && request.resource.data.caughtFishIds.size() <= 1000;

      // Profile update by owner: forbidden from modifying 'role' or 'createdAt'
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'displayName', 'clubId', 'clubName', 'caughtFishIds', 'lastLogin', 'avatarUrl'
           ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && (!('avatarUrl' in request.resource.data) || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 500))
        && request.resource.data.caughtFishIds is list
        && request.resource.data.caughtFishIds.size() <= 1000;

      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }
  }
}
