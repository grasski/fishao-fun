rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks whether the requesting user is an administrator
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Market prices: public read, update allowed for authenticated users (cannot delete, strictly prices_history only)
    match /fishao_market/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && docId == 'prices_history'
        && request.resource.data.keys().hasOnly(['prices', 'lastUpdated'])
        && request.resource.data.prices is map;
      allow update: if request.auth != null
        && docId == 'prices_history'
        && request.resource.data.keys().hasOnly(['prices', 'lastUpdated'])
        && request.resource.data.prices is map
        && (request.resource.data.prices.size() >= resource.data.prices.size() || isAdmin());
      allow delete: if isAdmin();
    }

    // Shared Clubs collection: public read, authenticated write/update
    match /clubs/{clubId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'name', 'name_lower', 'points', 'unlockedFcFishIds', 
             'unlockedMonsterIds', 'memberCount', 'members', 'createdBy', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.unlockedFcFishIds is list
        && request.resource.data.unlockedMonsterIds is list
        && request.resource.data.memberCount is number
        && (!('members' in request.resource.data) || request.resource.data.members is map)
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'name_lower', 'points', 'unlockedFcFishIds', 
             'unlockedMonsterIds', 'memberCount', 'members', 'updatedAt', 'lastUpdatedBy'
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.unlockedFcFishIds is list
        && request.resource.data.unlockedMonsterIds is list
        && request.resource.data.memberCount is number
        && (!('members' in request.resource.data) || request.resource.data.members is map)
        && (
          (resource.data.members is map && request.auth.uid in resource.data.members)
          || (request.resource.data.members is map && request.auth.uid in request.resource.data.members)
          || isAdmin()
        );

      allow delete: if isAdmin();
    }

    // User profiles: GDPR-free (NO email, NO avatar photo stored in DB)
    match /users/{userId} {
      // Authenticated users can read player profiles (nickname, avatar, club, caught fish)
      allow read: if request.auth != null;

      // Profile creation on first sign-in
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'displayName', 'role', 'clubId', 'clubName', 
             'caughtFishIds', 'backyardFishIds', 'friendUids', 'createdAt', 'lastLogin', 'avatarUrl'
           ])
        && request.resource.data.role == 'member'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && (!('avatarUrl' in request.resource.data) || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 500))
        && request.resource.data.caughtFishIds is list
        && request.resource.data.caughtFishIds.size() <= 1000
        && (!('backyardFishIds' in request.resource.data) || (request.resource.data.backyardFishIds is list && request.resource.data.backyardFishIds.size() <= 300))
        && (!('friendUids' in request.resource.data) || (request.resource.data.friendUids is list && request.resource.data.friendUids.size() <= 300));

      // Profile update by owner: forbidden from modifying 'role' or 'createdAt'
      // Note: evaluated with short-circuiting so normal users don't trigger extra isAdmin read!
      allow update: if (request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'displayName', 'clubId', 'clubName', 'caughtFishIds', 'backyardFishIds', 'friendUids', 'lastLogin', 'avatarUrl'
           ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && (!('avatarUrl' in request.resource.data) || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 500))
        && request.resource.data.caughtFishIds is list
        && request.resource.data.caughtFishIds.size() <= 1000
        && (!('backyardFishIds' in request.resource.data) || (request.resource.data.backyardFishIds is list && request.resource.data.backyardFishIds.size() <= 300))
        && (!('friendUids' in request.resource.data) || (request.resource.data.friendUids is list && request.resource.data.friendUids.size() <= 300)))
        || isAdmin();

      // Users can delete their own profile (GDPR self-service deletion), or admins
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }
  }
}
