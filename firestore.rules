rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: checks whether the requesting user is an administrator
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: checks whether manual price entry/import is enabled by admin
    function isManualImportEnabled() {
      return exists(/databases/$(database)/documents/fishao_market/config)
        && get(/databases/$(database)/documents/fishao_market/config).data.manualImportEnabled == true;
    }

    function isMarketSummaryDoc(docId) {
      return docId.matches('^prices_summary_[0-3]$');
    }

    // Sharded market summaries (0..3) & market config
    match /fishao_market/{docId} {
      allow read: if true;

      allow create: if (isSignedIn()
        && isMarketSummaryDoc(docId)
        && request.resource.data.keys().hasOnly(['prices', 'lastUpdated'])
        && request.resource.data.prices is map
        && request.resource.data.lastUpdated is string
        && (isAdmin() || isManualImportEnabled()))
        || (isAdmin()
        && docId == 'config'
        && request.resource.data.keys().hasOnly(['manualImportEnabled', 'lastUpdated'])
        && request.resource.data.manualImportEnabled is bool)
        || (isAdmin()
        && docId == 'sync_status'
        && request.resource.data.keys().hasOnly([
             'lastSuccessDate', 'lastSuccessAt', 'summaryMode', 'shardCount',
             'pricesFetched', 'addedCount', 'duplicateCount',
             'summaryBytes', 'maxShardBytes', 'summaryLimitPct', 'summaryUniquePrices'
           ])
        && request.resource.data.lastSuccessDate is string
        && request.resource.data.lastSuccessAt is string);

      allow update: if (isSignedIn()
        && isMarketSummaryDoc(docId)
        && request.resource.data.keys().hasOnly(['prices', 'lastUpdated'])
        && request.resource.data.prices is map
        && request.resource.data.lastUpdated is string
        && (isAdmin()
          || (isManualImportEnabled() && request.resource.data.prices.size() >= resource.data.prices.size())))
        || (isAdmin()
        && docId == 'config'
        && request.resource.data.keys().hasOnly(['manualImportEnabled', 'lastUpdated'])
        && request.resource.data.manualImportEnabled is bool)
        || (isAdmin()
        && docId == 'sync_status'
        && request.resource.data.keys().hasOnly([
             'lastSuccessDate', 'lastSuccessAt', 'summaryMode', 'shardCount',
             'pricesFetched', 'addedCount', 'duplicateCount',
             'summaryBytes', 'maxShardBytes', 'summaryLimitPct', 'summaryUniquePrices'
           ])
        && request.resource.data.lastSuccessDate is string
        && request.resource.data.lastSuccessAt is string);

      allow delete: if isAdmin();
    }

    // Monthly daily market price archive (/fishao_market_daily/{YYYY-MM})
    match /fishao_market_daily/{monthId} {
      allow read: if true;

      allow create: if isSignedIn()
        && monthId.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['days', 'lastUpdated'])
        && request.resource.data.days is map
        && (isAdmin() || isManualImportEnabled());

      allow update: if isSignedIn()
        && monthId.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['days', 'lastUpdated'])
        && request.resource.data.days is map
        && (isAdmin()
          || (isManualImportEnabled() && request.resource.data.days.size() >= resource.data.days.size()));

      allow delete: if isAdmin();
    }

    // Shared Clubs collection: public read, role-aware authenticated writes
    match /clubs/{clubId} {
      allow read: if true;

      function isClubMember() {
        return resource.data.members is map && request.auth.uid in resource.data.members;
      }

      function isClubCreator() {
        return resource.data.createdBy == request.auth.uid
          || (isClubMember()
              && resource.data.members[request.auth.uid] is map
              && resource.data.members[request.auth.uid].get('isCreator', false) == true);
      }

      function validMemberEntry(m) {
        return m is map
          && (!('displayName' in m) || (m.displayName is string && m.displayName.size() <= 40))
          && (!('preferredLang' in m) || (m.preferredLang is string
              && (m.preferredLang in ['cs', 'en', 'pl', 'nl', 'ro', 'tr']
                  || m.preferredLang.matches('^[A-Z]{2}$'))))
          && (!('avatarUrl' in m) || (m.avatarUrl is string
              && m.avatarUrl.size() <= 500
              && !m.avatarUrl.matches('.*[<>\"\'`].*')
              && !m.avatarUrl.matches('(?i)^\\s*(http:|javascript:|data:|vbscript:).*')))
          && (!('caughtCount' in m) || (m.caughtCount is int && m.caughtCount >= 0 && m.caughtCount <= 1000))
          && (!('caughtClubCount' in m) || (m.caughtClubCount is int && m.caughtClubCount >= 0 && m.caughtClubCount <= 200));
      }

      function validClubCommon() {
        return request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 40
          && (!('name_lower' in request.resource.data)
              || (request.resource.data.name_lower is string
                  && request.resource.data.name_lower == request.resource.data.name.lower()))
          && request.resource.data.points is number
          && request.resource.data.points >= 0
          && request.resource.data.points <= 100000000
          && request.resource.data.unlockedFcFishIds is list
          && request.resource.data.unlockedFcFishIds.size() <= 50
          && request.resource.data.unlockedMonsterIds is list
          && request.resource.data.unlockedMonsterIds.size() <= 20
          && request.resource.data.memberCount is int
          && request.resource.data.memberCount >= 0
          && request.resource.data.memberCount <= 1000
          && request.resource.data.members is map;
      }

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
             'name', 'name_lower', 'points', 'unlockedFcFishIds',
             'unlockedMonsterIds', 'memberCount', 'members', 'createdBy', 'createdAt', 'updatedAt'
           ])
        && validClubCommon()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && validMemberEntry(request.resource.data.members[request.auth.uid]);

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'name_lower', 'points', 'unlockedFcFishIds',
             'unlockedMonsterIds', 'memberCount', 'members', 'updatedAt', 'lastUpdatedBy'
           ])
        && validClubCommon()
        && (
          // 1. Club Creator can manage members, name, points, and unlocks (checked before isAdmin() to avoid extra /users read)
          isClubCreator()
          // 2. Non-member joining: may only add own member entry (not as creator) & update memberCount
          || (!isClubMember()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'members', 'memberCount', 'updatedAt', 'lastUpdatedBy'
                 ])
              && request.auth.uid in request.resource.data.members
              && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
              && validMemberEntry(request.resource.data.members[request.auth.uid])
              && request.resource.data.members[request.auth.uid].get('isCreator', false) == false
              && request.resource.data.memberCount == request.resource.data.members.size())
          // 3. Regular member leaving: may only remove own member entry & update memberCount
          || (isClubMember()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'members', 'memberCount', 'updatedAt', 'lastUpdatedBy'
                 ])
              && !(request.auth.uid in request.resource.data.members)
              && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
              && request.resource.data.memberCount == request.resource.data.members.size())
          // 4. Regular member updating points, special unlocks, or own member stats
          || (isClubMember()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                   'points', 'unlockedFcFishIds', 'unlockedMonsterIds', 'members', 'updatedAt', 'lastUpdatedBy'
                 ])
              && (!('members' in request.resource.data.diff(resource.data).affectedKeys())
                  || (request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
                      && request.auth.uid in request.resource.data.members
                      && validMemberEntry(request.resource.data.members[request.auth.uid])
                      && request.resource.data.members[request.auth.uid].get('isCreator', false)
                         == resource.data.members[request.auth.uid].get('isCreator', false))))
          // 5. Admin fallback (evaluated last so regular members never incur an extra /users/{uid} read)
          || isAdmin()
        );

      allow delete: if (isSignedIn() && isClubMember() && resource.data.members.size() <= 1)
        || isAdmin();
    }

    // Public community user profiles: GDPR-free (NO email, NO private settings)
    match /users/{userId} {
      function validPublicUserFields() {
        return request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 40
          && (!('preferredLang' in request.resource.data)
              || (request.resource.data.preferredLang is string
                  && (request.resource.data.preferredLang in ['cs', 'en', 'pl', 'nl', 'ro', 'tr']
                      || request.resource.data.preferredLang.matches('^[A-Z]{2}$'))))
          && (!('avatarUrl' in request.resource.data)
              || (request.resource.data.avatarUrl is string
                  && request.resource.data.avatarUrl.size() <= 500
                  && !request.resource.data.avatarUrl.matches('.*[<>\"\'`].*')
                  && !request.resource.data.avatarUrl.matches('(?i)^\\s*(http:|javascript:|data:|vbscript:).*')))
          && request.resource.data.caughtFishIds is list
          && request.resource.data.caughtFishIds.size() <= 1000
          && (!('shinyFishIds' in request.resource.data)
              || (request.resource.data.shinyFishIds is list
                  && request.resource.data.shinyFishIds.size() <= request.resource.data.caughtFishIds.size()))
          && (!('backyardFishIds' in request.resource.data)
              || (request.resource.data.backyardFishIds is list && request.resource.data.backyardFishIds.size() <= 300))
          && (!('badges' in request.resource.data)
              || (request.resource.data.badges is list && request.resource.data.badges.size() <= 20));
      }

      // Authenticated users can read public player profiles (nickname, avatar, club, caught & backyard fish)
      allow read: if isSignedIn();

      // Profile creation on first sign-in
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
             'displayName', 'role', 'clubId', 'clubName',
             'caughtFishIds', 'shinyFishIds', 'backyardFishIds', 'createdAt', 'avatarUrl',
             'preferredLang'
           ])
        && request.resource.data.role == 'member'
        && validPublicUserFields();

      // Profile update by owner: forbidden from modifying 'role'/'createdAt' or adding private fields here
      allow update: if (isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).addedKeys().hasOnly([
             'displayName', 'clubId', 'clubName', 'caughtFishIds', 'shinyFishIds', 'backyardFishIds', 'avatarUrl', 'preferredLang'
           ])
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
             'displayName', 'clubId', 'clubName', 'caughtFishIds', 'shinyFishIds', 'backyardFishIds', 'avatarUrl', 'preferredLang'
           ])
        && request.resource.data.diff(resource.data).removedKeys().hasOnly([
             'avatarUrl', 'preferredLang'
           ])
        && validPublicUserFields())
        || isAdmin();

      // Users can delete their own profile (GDPR self-service deletion), or admins
      allow delete: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // Private user settings (reminders, friendUids, lastLogin) - owner & admin only
      match /private/{docId} {
        allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

        allow create, update: if ((isSignedIn() && request.auth.uid == userId) || isAdmin())
          && docId == 'settings'
          && request.resource.data.keys().hasOnly(['reminders', 'friendUids', 'lastLogin', 'updatedAt', 'treeLevel', 'lineLevel'])
          && (!('reminders' in request.resource.data)
              || (request.resource.data.reminders is list && request.resource.data.reminders.size() <= 100))
          && (!('friendUids' in request.resource.data)
              || (request.resource.data.friendUids is list && request.resource.data.friendUids.size() <= 300))
          && (!('treeLevel' in request.resource.data)
              || (request.resource.data.treeLevel is int && request.resource.data.treeLevel >= 1 && request.resource.data.treeLevel <= 20))
          && (!('lineLevel' in request.resource.data)
              || (request.resource.data.lineLevel is int && request.resource.data.lineLevel >= 1 && request.resource.data.lineLevel <= 20));

        allow delete: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }
    }

    // -------------------------------------------------------------
    // Private 1-on-1 Player Chat, Moderation Reports & Chat Bans
    // -------------------------------------------------------------
    function isChatBanned() {
      return exists(/databases/$(database)/documents/chat_bans/$(request.auth.uid))
        && (get(/databases/$(database)/documents/chat_bans/$(request.auth.uid)).data.bannedUntil == null
            || get(/databases/$(database)/documents/chat_bans/$(request.auth.uid)).data.bannedUntil > request.time);
    }

    function chatOtherParticipant(parts) {
      return parts[0] == request.auth.uid ? parts[1] : parts[0];
    }

    function chatOtherParticipantExists(parts) {
      return exists(/databases/$(database)/documents/users/$(chatOtherParticipant(parts)));
    }

    function validChatParticipantInfo(info) {
      return info is map
        && info.keys().hasOnly(['displayName', 'avatarUrl', 'deleted', 'lang'])
        && 'displayName' in info
        && 'avatarUrl' in info
        && info.displayName is string
        && info.displayName.size() >= 1
        && info.displayName.size() <= 40
        && info.avatarUrl is string
        && info.avatarUrl.size() <= 500
        && !info.avatarUrl.matches('(?s).*[<>\"\'`].*')
        && !info.avatarUrl.matches('(?is)^\\s*(http:|javascript:|data:|vbscript:).*')
        && (!('lang' in info)
            || (info.lang is string
                && (info.lang in ['cs', 'en', 'pl', 'nl', 'ro', 'tr']
                    || info.lang.matches('^[A-Z]{2}$'))))
        && (!('deleted' in info)
            || (info.deleted is bool
                && (!info.deleted || !exists(/databases/$(database)/documents/users/$(request.auth.uid)))));
    }

    function validChatText(txt, maxLen) {
      return txt is string
        && txt.size() >= 1
        && txt.size() <= maxLen
        && !txt.matches('(?s).*[<>].*')
        && !txt.matches('(?is).*(https?://|ftp://|www\\.|javascript:|vbscript:|data:|mailto:).*')
        && !txt.matches('(?is).*(\\bdiscord\\.gg|\\bdiscord\\.com/invite|\\bt\\.me|\\bbit\\.ly|\\btinyurl\\.com|\\bgoo\\.gl|\\brb\\.gy|\\bshorturl\\.at|\\bis\\.gd|\\bcutt\\.ly).*')
        && !txt.matches('(?is).*(^|[^a-z0-9@._%+-])[a-z0-9-]+(\\.[a-z0-9-]+)*\\.(com|net|org|cz|sk|pl|eu|io|gg|xyz|info|biz|ru)\\b.*');
    }

    function validChatPreviewText(txt) {
      return validChatText(txt, 80);
    }

    // Chat threads: strictly private to the two participants (NOT readable by admins)
    match /chats/{pairId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && !isChatBanned()
        && request.resource.data.keys().hasOnly([
             'participants', 'participantInfo', 'status', 'requestedBy', 'blockedBy',
             'reason', 'lastMessagePreview', 'lastSenderUid', 'lastMessageAt', 'lastMessageId',
             'lastReadAt', 'createdAt', 'updatedAt', 'expiresAt'
           ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && pairId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(chatOtherParticipant(request.resource.data.participants)))
        && request.resource.data.participantInfo is map
        && request.resource.data.participantInfo.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.participantInfo.keys().hasAll(request.resource.data.participants)
        && validChatParticipantInfo(request.resource.data.participantInfo[request.resource.data.participants[0]])
        && validChatParticipantInfo(request.resource.data.participantInfo[request.resource.data.participants[1]])
        && request.resource.data.participantInfo[request.resource.data.participants[0]].get('deleted', false) == false
        && request.resource.data.participantInfo[request.resource.data.participants[1]].get('deleted', false) == false
        && request.resource.data.status == 'pending'
        && request.resource.data.blockedBy == null
        && request.resource.data.reason in ['meetup', 'backyard', 'club', 'trading', 'discord', 'general']
        && request.resource.data.lastMessagePreview == ''
        && request.resource.data.lastSenderUid == null
        && request.resource.data.lastMessageAt == null
        && (!('lastMessageId' in request.resource.data) || request.resource.data.lastMessageId == null)
        && request.resource.data.lastReadAt is map
        && request.auth.uid in request.resource.data.lastReadAt
        && request.resource.data.lastReadAt.keys().hasOnly([request.auth.uid])
        && request.resource.data.lastReadAt[request.auth.uid] == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(21, 'd');

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.keys().hasOnly([
             'participants', 'participantInfo', 'status', 'requestedBy', 'blockedBy',
             'preBlockStatus', 'reason', 'lastMessagePreview', 'lastSenderUid',
             'lastMessageAt', 'lastMessageId', 'lastReadAt', 'createdAt', 'updatedAt', 'expiresAt', 'hiddenBy'
           ])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // 1. Recipient accepts or rejects a pending (or previously rejected) request
          (resource.data.status in ['pending', 'rejected']
            && request.auth.uid != resource.data.requestedBy
            && request.resource.data.status in ['accepted', 'rejected']
            && (request.resource.data.status == 'rejected' || !isChatBanned())
            && request.resource.data.blockedBy == null
            && request.resource.data.expiresAt == null
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status', 'updatedAt', 'expiresAt', 'lastReadAt', 'participantInfo'
               ])
            && (!('lastReadAt' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.lastReadAt is map
                    && request.resource.data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid])
                    && request.resource.data.lastReadAt[request.auth.uid] == request.time))
            && (!('participantInfo' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.participantInfo is map
                    && request.resource.data.participantInfo.diff(resource.data.participantInfo).affectedKeys().hasOnly([request.auth.uid])
                    && validChatParticipantInfo(request.resource.data.participantInfo[request.auth.uid]))))
          // 2. Either participant blocks the conversation (blocked records do not auto-expire)
          || (resource.data.status in ['pending', 'accepted', 'rejected']
            && request.resource.data.status == 'blocked'
            && request.resource.data.blockedBy == request.auth.uid
            && request.resource.data.expiresAt == null
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status', 'blockedBy', 'preBlockStatus', 'updatedAt', 'expiresAt'
               ])
            && (!('preBlockStatus' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.preBlockStatus == resource.data.status))
          // 3. Atomic message metadata update inside an accepted conversation (with 2s sender cooldown & live peer check)
          || (resource.data.status == 'accepted'
            && !isChatBanned()
            && chatOtherParticipantExists(resource.data.participants)
            && resource.data.participantInfo[chatOtherParticipant(resource.data.participants)].get('deleted', false) != true
            && request.resource.data.status == 'accepted'
            && request.resource.data.blockedBy == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'lastMessagePreview', 'lastSenderUid', 'lastMessageAt', 'lastMessageId',
                 'lastReadAt', 'updatedAt', 'participantInfo'
               ])
            && request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessageAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.lastMessageId is string
            && request.resource.data.lastMessageId.size() >= 1
            && request.resource.data.lastMessageId.size() <= 128
            && validChatPreviewText(request.resource.data.lastMessagePreview)
            && (resource.data.lastMessageAt == null
                || resource.data.lastSenderUid != request.auth.uid
                || request.time >= resource.data.lastMessageAt + duration.value(2, 's'))
            && (!('lastReadAt' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.lastReadAt is map
                    && request.resource.data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid])
                    && request.resource.data.lastReadAt[request.auth.uid] == request.time))
            && (!('participantInfo' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.participantInfo is map
                    && request.resource.data.participantInfo.diff(resource.data.participantInfo).affectedKeys().hasOnly([request.auth.uid])
                    && validChatParticipantInfo(request.resource.data.participantInfo[request.auth.uid]))))
          // 4. Read receipt or own participant info update (rename / account deletion anonymization)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt', 'participantInfo'])
            && (!('lastReadAt' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.lastReadAt is map
                    && request.resource.data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid])
                    && request.resource.data.lastReadAt[request.auth.uid] == request.time))
            && (!('participantInfo' in request.resource.data.diff(resource.data).affectedKeys())
                || (request.resource.data.participantInfo is map
                    && request.resource.data.participantInfo.diff(resource.data.participantInfo).affectedKeys().hasOnly([request.auth.uid])
                    && validChatParticipantInfo(request.resource.data.participantInfo[request.auth.uid]))))
          // 5. Surviving participant hides an orphaned chat when the other player's account was deleted
          || ((!chatOtherParticipantExists(resource.data.participants)
               || resource.data.participantInfo[chatOtherParticipant(resource.data.participants)].get('deleted', false) == true)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenBy', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.hiddenBy is list
            && request.resource.data.hiddenBy.size() <= 2
            && request.auth.uid in request.resource.data.hiddenBy
            && (!('hiddenBy' in resource.data) || request.resource.data.hiddenBy.hasAll(resource.data.hiddenBy)))
          // 6. Blocker restores a previously accepted conversation back to active without losing history
          || (resource.data.status == 'blocked'
            && request.auth.uid == resource.data.blockedBy
            && (resource.data.get('preBlockStatus', '') == 'accepted'
                || resource.data.lastMessageAt != null)
            && request.resource.data.status == 'accepted'
            && request.resource.data.blockedBy == null
            && request.resource.data.preBlockStatus == null
            && request.resource.data.expiresAt == null
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status', 'blockedBy', 'preBlockStatus', 'updatedAt', 'expiresAt'
               ]))
        );

      // Sender can cancel own pending request; recipient can clear own rejection;
      // blocker can remove own block record (only if never accepted);
      // surviving participant can delete non-accepted orphaned chat when other profile was deleted
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && resource.data.get('preBlockStatus', '') != 'accepted'
        && resource.data.lastMessageAt == null
        && ((resource.data.status == 'pending' && request.auth.uid == resource.data.requestedBy)
            || (resource.data.status == 'rejected' && request.auth.uid != resource.data.requestedBy)
            || (resource.data.status == 'blocked' && request.auth.uid == resource.data.blockedBy)
            || (resource.data.status in ['pending', 'rejected', 'blocked']
                && !chatOtherParticipantExists(resource.data.participants)));

      // Chat messages: plain text <= 300 chars, no URLs/HTML, immutable for evidence integrity
      match /messages/{msgId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(pairId)).data.participants;

        allow create: if isSignedIn()
          && !isChatBanned()
          && exists(/databases/$(database)/documents/chats/$(pairId))
          && get(/databases/$(database)/documents/chats/$(pairId)).data.status == 'accepted'
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(pairId)).data.participants
          && chatOtherParticipantExists(get(/databases/$(database)/documents/chats/$(pairId)).data.participants)
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt', 'expiresAt'])
          && request.resource.data.senderUid == request.auth.uid
          && validChatText(request.resource.data.text, 300)
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(21, 'd')
          && getAfter(/databases/$(database)/documents/chats/$(pairId)).data.lastMessageAt == request.time
          && getAfter(/databases/$(database)/documents/chats/$(pairId)).data.lastSenderUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/chats/$(pairId)).data.lastMessageId == msgId;

        allow update, delete: if false;
      }
    }

    function validChatReportPayload(reportId) {
      return request.resource.data.keys().hasOnly([
           'chatId', 'reporterUid', 'reportedUid', 'category',
           'note', 'evidenceMessages', 'status', 'createdAt', 'expiresAt'
         ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.chatId is string
        && request.resource.data.chatId.matches('^[A-Za-z0-9_-]{3,128}$')
        && reportId == request.auth.uid + '_' + request.resource.data.reportedUid
        && exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants
        && request.resource.data.reportedUid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants
        && request.resource.data.category in ['illegal_content', 'harassment', 'phishing_scam', 'spam', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && !request.resource.data.note.matches('(?s).*[<>].*')
        && request.resource.data.evidenceMessages is list
        && request.resource.data.evidenceMessages.size() <= 15
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(100, 'd');
    }

    // Moderation reports (created by chat participants on abuse, readable/manageable by admins)
    match /chat_reports/{reportId} {
      allow get: if isAdmin()
        || (isSignedIn() && (
             (resource == null && reportId.matches('^' + request.auth.uid + '_.+$'))
             || (resource != null && resource.data.reporterUid == request.auth.uid)
           ));
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && !isChatBanned()
        && validChatReportPayload(reportId);

      // Admin can resolve/dismiss; reporter can only overwrite AFTER previous report was resolved/dismissed
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['open', 'resolved', 'dismissed'])
        || (isSignedIn()
            && !isChatBanned()
            && resource.data.reporterUid == request.auth.uid
            && resource.data.reportedUid == request.resource.data.reportedUid
            && resource.data.status in ['resolved', 'dismissed']
            && validChatReportPayload(reportId));

      allow delete: if isAdmin();
    }

    // Chat bans (readable by affected owner or admin, writable strictly by admin)
    match /chat_bans/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['reason', 'bannedAt', 'bannedUntil', 'bannedBy'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 120
        && !request.resource.data.reason.matches('(?s).*[<>].*')
        && request.resource.data.bannedAt is timestamp
        && (request.resource.data.bannedUntil == null || request.resource.data.bannedUntil is timestamp)
        && request.resource.data.bannedBy == request.auth.uid;

      allow delete: if isAdmin();
    }
  }
}
